# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoice_generator
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=your_secure_password_here

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Twilio Configuration (WhatsApp - Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SuprSend Configuration (Optional)
SUPRSEND_WORKSPACE_KEY=your_suprsend_workspace_key
SUPRSEND_WORKSPACE_SECRET=your_suprsend_workspace_secret
SUPRSEND_WORKSPACE_URL=https://hub.suprsend.com
SUPRSEND_INVOICE_TEMPLATE=follower-testimonial-request-free-calls

# Topmate Invoice Settings (Optional - has defaults)
TOPMATE_COMPANY_NAME=Topmate Technologies Pvt Ltd
TOPMATE_GSTIN=29AAFCT0123A1Z5
TOPMATE_ADDRESS=123 Business Park, HSR Layout, Bangalore, Karnataka
TOPMATE_PINCODE=560102
TOPMATE_STATE=Karnataka
TOPMATE_STATE_CODE=29
TOPMATE_PHONE=+91 8012345678
